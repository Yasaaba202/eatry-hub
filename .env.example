# Database (Neon or Supabase Postgres)
# Pooled connection string. Neon: host contains "-pooler". Supabase: use the pooler host.
DATABASE_URL=
# Direct connection string (no pooler). Prisma Migrate requires this one.
DIRECT_URL=

# Session signing keys. Generate each with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Each must be at least 32 characters, and the two must be different.
AUTH_SESSION_SECRET=
ADMIN_SESSION_SECRET=

# Email delivery (Gmail SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional sender address. Defaults to GMAIL_USER.
EMAIL_FROM=

# Public origin used to build email links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional fallback when NEXT_PUBLIC_SITE_URL is not set.
APP_URL=

# Admin bootstrap. Used only when no AdminCredential row (id "primary") exists.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Meal image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: admin food-catalog image import. Server-only service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=food-catalog
IMAGE_IMPORT_USER_AGENT=

# Optional tuning
RATE_LIMIT_STRICT=
ORDER_TRACKING_LEGACY_UNTIL=